---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPublicPosts, selectPosts, postUrl, formatDate, tagUrl, publicTags, type Post } from '../lib/posts';
import { locales, ui, sitePath, type Locale } from '../lib/i18n';
export async function getStaticPaths() {
  const posts = await getPublicPosts();
  const pages = locales.flatMap(locale => ['home', 'posts', 'about'].map(kind => {
    const path = kind === 'home' ? '' : `${kind}/`;
    const other = locale === 'zh' ? 'en' : 'zh';
    return { params: { page: sitePath(locale, path).replace(/^\//, '').replace(/\/$/, '') || undefined },
      props: { locale, kind, posts: selectPosts(posts, locale), alternate: { locale: other, href: sitePath(other, path) } } };
  }));
  const tagPages = publicTags(posts).flatMap(tag => locales.map(locale => {
    const other = locale === 'zh' ? 'en' : 'zh';
    return { params: { page: tagUrl(tag, locale).slice(1, -1) }, props: {
      locale, kind: 'tag', tag,
      posts: selectPosts(posts.filter(post => post.data.tags.includes(tag)), locale),
      alternate: { locale: other, href: tagUrl(tag, other) }
    }};
  }));
  return [...pages, ...tagPages, ...posts.map(post => {
    const other = posts.find(candidate => candidate.slug === post.slug && candidate.locale !== post.locale);
    return { params: { page: postUrl(post).slice(1, -1) }, props: { locale: post.locale, kind: 'article', post, alternate: other ? { locale: other.locale, href: postUrl(other) } : undefined } };
  })];
}
interface Props { locale: Locale; kind: string; tag?: string; posts?: Post[]; post?: Post; alternate?: { locale: Locale; href: string } }
const { locale, kind, tag, posts = [], post, alternate } = Astro.props;
const t = ui[locale];
const rendered = post ? await render(post) : undefined;
const Content = rendered?.Content;
const title = tag ? `#${tag}` : post?.data.title ?? (kind === 'posts' ? t.posts : kind === 'about' ? t.about : undefined);
---
<Base locale={locale} title={title} description={post?.data.description || t.description} alternate={alternate}>
  {kind === 'home' && <>
    <section class="home-hero"><h1 aria-label={t.headline.join(' ')}><span data-warp-text>{t.headline[0]}</span><span data-warp-text>{t.headline[1]}</span></h1><p class="intro-description">{t.subtitle}</p></section>
    <section aria-labelledby="latest"><div class="section-heading"><h2 id="latest"><span class="section-number">01</span>{t.latest}</h2><a href={sitePath(locale, 'posts/')}>{t.all} ↗</a></div>
      {posts.length ? <PostList posts={posts.slice(0, 5)} locale={locale} /> : <div class="empty"><i class="empty-mark" aria-hidden="true"></i><div><p>{t.empty}</p><span>{t.next}</span></div></div>}
    </section>
  </>}
  {(kind === 'posts' || kind === 'tag') && <><header class="page-heading"><h1 data-warp-text={kind === 'posts' ? true : undefined}>{tag ? `#${tag}` : t.posts}</h1><p class="intro-description">{tag ? (locale === 'zh' ? '按标签浏览文章' : 'Browse articles by tag') : t.subtitle}</p>{tag && <a class="back" href={sitePath(locale, 'posts/')}>← {t.all}</a>}</header><div class="section-heading"><h2>{tag ? (locale === 'zh' ? '此标签下的文章' : 'Posts with this tag') : t.all}</h2><span class="section-label">{String(posts.length).padStart(2, '0')}</span></div>{posts.length ? <PostList posts={posts} locale={locale} /> : <div class="empty"><i class="empty-mark" aria-hidden="true"></i><div><p>{t.empty}</p><span>{t.next}</span></div></div>}</>}
  {kind === 'about' && <section class="about-layout"><p class="eyebrow">BEHIND THE NOTES</p><div><h1 data-warp-text>{t.hello}</h1><div class="prose"><p>{t.bio}</p><p>{t.note}</p><p><a href="https://github.com/Wp-Zhang">{t.github} ↗</a></p></div></div></section>}
  {post && Content && <article><a class="back" href={sitePath(locale, 'posts/')}>← {t.all}</a><header class="article-header"><div class="article-meta"><span>WEIPENG ZHANG</span><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, locale)}</time></div><h1>{post.data.title}</h1><p>{post.data.description}</p><div class="tags">{post.data.tags.filter(Boolean).map(tag => <a href={tagUrl(tag, locale)}>{tag}</a>)}</div></header><div class="prose"><Content /></div><div class="article-end"><span>Weipeng Zhang</span><a href={sitePath(locale, 'posts/')}>{t.all} ↗</a></div></article>}
</Base>
