---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPublicPosts, selectPosts, postUrl, formatDate, type Post } from '../lib/posts';
import { locales, ui, sitePath, type Locale } from '../lib/i18n';
export async function getStaticPaths() {
  const posts = await getPublicPosts();
  const pages = locales.flatMap(locale => ['home', 'posts', 'about'].map(kind => {
    const path = kind === 'home' ? '' : `${kind}/`;
    const other = locale === 'zh' ? 'en' : 'zh';
    return { params: { page: sitePath(locale, path).replace(/^\//, '').replace(/\/$/, '') || undefined },
      props: { locale, kind, posts: selectPosts(posts, locale), alternate: { locale: other, href: sitePath(other, path) } } };
  }));
  return [...pages, ...posts.map(post => {
    const other = posts.find(candidate => candidate.slug === post.slug && candidate.locale !== post.locale);
    return { params: { page: postUrl(post).slice(1, -1) }, props: { locale: post.locale, kind: 'article', post, alternate: other ? { locale: other.locale, href: postUrl(other) } : undefined } };
  })];
}
interface Props { locale: Locale; kind: string; posts?: Post[]; post?: Post; alternate?: { locale: Locale; href: string } }
const { locale, kind, posts = [], post, alternate } = Astro.props;
const t = ui[locale];
const rendered = post ? await render(post) : undefined;
const Content = rendered?.Content;
const title = post?.data.title ?? (kind === 'posts' ? t.posts : kind === 'about' ? t.about : undefined);
---
<Base locale={locale} title={title} description={post?.data.description || t.description} alternate={alternate}>
  {kind === 'home' && <>
    <section class="intro"><p class="eyebrow">WEIPENG ZHANG / NOTES & IDEAS</p><h1>{t.headline[0]}<br />{t.headline[1]}</h1><p class="intro-description">{t.subtitle}</p></section>
    <section aria-labelledby="latest"><div class="section-heading"><h2 id="latest">{t.latest}</h2><a href={sitePath(locale, 'posts/')}>{t.all} ↗</a></div>
      {posts.length ? <PostList posts={posts.slice(0, 5)} locale={locale} /> : <div class="empty"><p>{t.empty}</p><span>{t.next}</span></div>}
    </section>
  </>}
  {kind === 'posts' && <><p class="eyebrow">THE NOTEBOOK</p><h1>{t.posts}</h1>{posts.length ? <PostList posts={posts} locale={locale} /> : <p class="empty">{t.noPosts}</p>}</>}
  {kind === 'about' && <><p class="eyebrow">BEHIND THE NOTES</p><h1>{t.hello}</h1><div class="prose"><p>{t.bio}</p><p>{t.note}</p><p><a href="https://github.com/Wp-Zhang">{t.github} ↗</a></p></div></>}
  {post && Content && <article><a class="back" href={sitePath(locale, 'posts/')}>← {t.all}</a><header class="article-header"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, locale)}</time><h1>{post.data.title}</h1><p>{post.data.description}</p><div class="tags">{post.data.tags.map(tag => <span>{tag}</span>)}</div></header><div class="prose"><Content /></div></article>}
</Base>
