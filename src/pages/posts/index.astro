---
import Base from '../../layouts/Base.astro';
import { getPublicPosts, postUrl, formatDate } from '../../lib/posts';
const posts = await getPublicPosts();
---
<Base title="文章">
  <p class="eyebrow">THE NOTEBOOK</p><h1>文章</h1>
  {posts.length ? <ul class="post-list">{posts.map(post => (
    <li><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><h2><a href={postUrl(post.id)}>{post.data.title}</a></h2><p>{post.data.description}</p></li>
  ))}</ul> : <p class="empty">还没有公开文章，敬请期待。</p>}
</Base>
