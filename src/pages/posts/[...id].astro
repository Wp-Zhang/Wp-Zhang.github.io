---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPublicPosts, formatDate } from '../../lib/posts';
export async function getStaticPaths() {
  return (await getPublicPosts()).map(post => ({ params: { id: post.id }, props: { post } }));
}
interface Props { post: CollectionEntry<'posts'> }
const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.description}>
  <article>
    <a class="back" href="/posts/">← 全部文章</a>
    <header class="article-header"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><h1>{post.data.title}</h1><p>{post.data.description}</p><div class="tags">{post.data.tags.map(tag => <span>{tag}</span>)}</div></header>
    <div class="prose"><Content /></div>
  </article>
</Base>
