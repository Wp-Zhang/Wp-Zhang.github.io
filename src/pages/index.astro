---
import Base from '../layouts/Base.astro';
import { getPublicPosts, postUrl, formatDate } from '../lib/posts';
const posts = await getPublicPosts();
---
<Base>
  <section class="intro">
    <p class="eyebrow">WEIPENG ZHANG / NOTES & IDEAS</p>
    <h1>记录，思考，<br />继续探索。</h1>
    <p class="intro-description">关于技术、阅读与生活的笔记。</p>
  </section>
  <section aria-labelledby="latest">
    <div class="section-heading"><h2 id="latest">最近的文章</h2><a href="/posts/">全部文章 ↗</a></div>
    {posts.length ? <ul class="post-list">{posts.slice(0, 5).map(post => (
      <li><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><h3><a href={postUrl(post.id)}>{post.data.title}</a></h3><p>{post.data.description}</p></li>
    ))}</ul> : <div class="empty"><p>新的篇章，正在酝酿。</p><span>下一篇文章见。</span></div>}
  </section>
</Base>
